# Use an OpenAI key, or a DeepSeek key with the DeepSeek base URL below.
OPENAI_API_KEY=
# Leave OPENAI_BASE_URL empty for OpenAI; for DeepSeek use https://api.deepseek.com
OPENAI_BASE_URL=
# DeepSeek: deepseek-v4-flash (non-thinking) or deepseek-v4-pro (thinking)
# OpenAI example: gpt-4o-mini
OPENAI_MODEL=deepseek-v4-flash
# Stories per briefing, between 5 and 10 (default 10)
MAX_STORIES=10

# EMAIL_PASSWORD is the SMTP authorization/app password, not your account login password
# (e.g. QQ Mail authorization code, or a Gmail app password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=
EMAIL_FROM=

# Optional: WeChat push. Recommended: Server酱 SendKey (https://sct.ftqq.com) or a PushPlus token.
SERVERCHAN_SENDKEY=
PUSHPLUS_TOKEN=
